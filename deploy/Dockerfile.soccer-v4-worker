FROM node:22.23.2-trixie-slim
ENV NODE_ENV=production
WORKDIR /app
COPY backend/package*.json ./backend/
RUN cd backend && npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY backend/src ./backend/src
RUN node --check backend/src/sportsbook-next/soccer-v4-worker.js \
 && node --check backend/src/sportsbook-next/soccer-v4-client.js \
 && node --check backend/src/sportsbook-next/soccer-v4-quota.js \
 && node --check backend/src/sportsbook-next/results-repository.js
CMD ["node", "backend/src/sportsbook-next/soccer-v4-worker.js"]
