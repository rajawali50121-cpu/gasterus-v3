FROM node:22.23.2-trixie-slim
ENV NODE_ENV=production SPORTSBOOK_SETTLEMENT_ENABLED=false
WORKDIR /app
COPY backend/package*.json ./backend/
RUN cd backend && npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY backend/src ./backend/src
RUN node --check backend/src/sportsbook-next/settlement-worker.js && node --check backend/src/sportsbook-next/settlement-service.js
CMD ["node", "backend/src/sportsbook-next/settlement-worker.js"]
