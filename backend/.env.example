# Core app settings
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://localhost:5432/gasterus
REDIS_URL=redis://:redispass@localhost:6379
MEMBER_PROXY_SECRET=replace-with-32-plus-random-characters
ADMIN_PROXY_SECRET=replace-with-32-plus-random-characters
OPS_INTERNAL_SECRET=replace-with-32-plus-random-characters
SESSION_HMAC_KEY=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-32-plus-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key
SPORTSBOOK_INGEST_URL=https://gasterus-v3-production.up.railway.app/api/internal/sportsbook/ingest
SPORTSBOOK_INGEST_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SPORTSBOOK_INGEST_MAX_PAYLOAD_BYTES=6291456
SPORTSBOOK_INGEST_MAX_AGE_SECONDS=180
# Persistent sportsbook render-worker target/page budget.
SPORTSBOOK_RENDER_MAX_EVENTS=500
SPORTSBOOK_RENDER_MAX_PAGES=120

# Set provider credentials once on Railway service "gasterus-v3"; the dedicated
# "sportsbook-render-worker" inherits them (see .railway/railway.ts). Heap is
# capped at 224MB and the sport list is limited to keep worker memory bounded.
THE_ODDS_API_ENABLED=true
THE_ODDS_API_KEY=replace-with-your-the-odds-api-key
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MARKETS=h2h,spreads,totals
THE_ODDS_API_REFRESH_SECONDS=840
THE_ODDS_API_MAX_TOTAL_EVENTS=500
THE_ODDS_API_EVENT_MARKETS_ENABLED=false
THE_ODDS_API_SPORT_KEYS=soccer_epl,soccer_spain_la_liga
SPORTSBOOK_LIVE_ACCEPTANCE_DELAY_MS=3000
SPORTSBOOK_MANUAL_FT_SETTLEMENT_FALLBACK_ENABLED=false
TOTO_SINGLE_SOURCE_CAN_PUBLISH_VERIFIED=false

# Feed workers
FEED_WORKER_ENABLED=true
SPORTS_SOURCE_BACKGROUND_POLL_ENABLED=true
SPORTS_FEED_MAX_EVENTS=500
SPORTS_FEED_MAX_CACHE_BYTES=8388608

# Provider response cache limits
SPORTS_PROVIDER_CACHE_MAX_ENTRIES=120
SPORTS_PROVIDER_CACHE_MAX_ENTRY_BYTES=3145728
SPORTS_PROVIDER_CACHE_MAX_TOTAL_BYTES=10000000
