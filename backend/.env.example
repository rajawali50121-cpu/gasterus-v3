# Core app settings
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://localhost:5432/gasterus
REDIS_URL=redis://:redispass@localhost:6379
MEMBER_PROXY_SECRET=replace-with-32-plus-random-characters
ADMIN_PROXY_SECRET=replace-with-32-plus-random-characters
OPS_INTERNAL_SECRET=replace-with-32-plus-random-characters
SESSION_HMAC_KEY=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-32-plus-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key
SPORTSBOOK_INGEST_URL=https://gasterus-v3-production.up.railway.app/api/internal/sportsbook/ingest
SPORTSBOOK_INGEST_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SPORTSBOOK_INGEST_MAX_PAYLOAD_BYTES=6291456
SPORTSBOOK_INGEST_MAX_AGE_SECONDS=180
# Persistent sportsbook render-worker target/page budget.
SPORTSBOOK_RENDER_MAX_EVENTS=500
SPORTSBOOK_RENDER_MAX_PAGES=120

# Provider credentials are consumed by the dedicated Railway render worker
# (see .railway/railway.ts), with its heap capped at 224MB.
# Sportmonks performs the full catalog refresh separately from its live window.
SPORTMONKS_ENABLED=true
SPORTMONKS_API_KEY=replace-with-your-sportmonks-api-key
SPORTMONKS_DAYS_AHEAD=30
SPORTMONKS_MAX_TOTAL_EVENTS=500
SPORTMONKS_REFRESH_SECONDS=300
SPORTMONKS_ODDS_REFRESH_SECONDS=180
SPORTMONKS_LIVE_REFRESH_SECONDS=30

# API-Football / API-Sports worker key (Free plan verified at 100 requests/day).
# The adapter also accepts API_SPORTS_KEY for environments using that name.
API_FOOTBALL_KEY=replace-with-your-api-football-key
API_SPORTS_ENABLED=true
API_SPORTS_DAILY_QUOTA=100
API_SPORTS_MONTHLY_QUOTA=3100

# Optional OddsPapi enrichment; disabled unless explicitly enabled.
# Free-tier guardrails: max 8 requests/day and 240 requests/month.
# Quota reservations are durable in PostgreSQL; apply migration 041 before enabling.
# Redis is limited to provider cache, cooldown, and refresh locking.
ODDSPAPI_ENABLED=false
ODDSPAPI_BASE_URL=https://api.oddspapi.io
# Priority IDs; worker also discovers fixture-backed competitions from the API catalog.
ODDSPAPI_TOURNAMENT_IDS=17
ODDSPAPI_BOOKMAKER=pinnacle
ODDSPAPI_REFRESH_SECONDS=28800
ODDSPAPI_CATALOG_REFRESH_SECONDS=604800
ODDSPAPI_DAILY_REQUEST_BUDGET=8
ODDSPAPI_MONTHLY_REQUEST_BUDGET=240
SPORTSBOOK_LIVE_ACCEPTANCE_DELAY_MS=3000

# Feed workers
FEED_WORKER_ENABLED=true
SPORTS_SOURCE_BACKGROUND_POLL_ENABLED=true

# Provider response cache limits
SPORTS_PROVIDER_CACHE_MAX_ENTRIES=120
SPORTS_PROVIDER_CACHE_MAX_ENTRY_BYTES=3145728
SPORTS_PROVIDER_CACHE_MAX_TOTAL_BYTES=10000000
