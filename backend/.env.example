# Core app settings
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://localhost:5432/gasterus
REDIS_URL=redis://:redispass@localhost:6379
MEMBER_PROXY_SECRET=replace-with-32-plus-random-characters
ADMIN_PROXY_SECRET=replace-with-32-plus-random-characters
OPS_INTERNAL_SECRET=replace-with-32-plus-random-characters
SESSION_HMAC_KEY=replace-with-32-plus-random-characters
API_KEY_PEPPER=replace-with-32-plus-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-secret
SPORTSBOOK_INGEST_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SPORTSBOOK_INGEST_MAX_AGE_SECONDS=600

# Betnex real-money mode stays disabled until its official seamless-wallet
# callback contract has been verified and configured with Betnex.
BETNEX_API_KEY=replace-with-your-betnex-api-key
BETNEX_CALLBACK_KEY=replace-with-your-betnex-callback-key
BETNEX_REAL_MONEY_ENABLED=false
BETNEX_SEAMLESS_WALLET_PROTOCOL_VERIFIED=false
# Fractional callback amounts stay rejected until Betnex confirms their ledger unit.
# Set to "warn" only to lower the log severity; the callback remains rejected.
BETNEX_CALLBACK_FRACTIONAL_POLICY=reject

# Backend consumes only signed worker snapshots; it never stores the odds-provider API key.
SPORTSBOOK_DAILY_REFRESH_ENABLED=false
SPORTSBOOK_POLL_MINUTES=150
SPORTSBOOK_RISK_REPRICING_ENABLED=true
SPORTSBOOK_RISK_REPRICING_MAX_SHADE_BPS=600
SPORTSBOOK_AUTO_SETTLEMENT_ENABLED=false
SPORTSBOOK_LIVE_ACCEPTANCE_DELAY_MS=3000

# Feed workers
FEED_WORKER_ENABLED=true
SPORTS_SOURCE_BACKGROUND_POLL_ENABLED=true

# Provider response cache limits
SPORTS_PROVIDER_CACHE_MAX_ENTRIES=120
SPORTS_PROVIDER_CACHE_MAX_ENTRY_BYTES=3145728
SPORTS_PROVIDER_CACHE_MAX_TOTAL_BYTES=10000000

