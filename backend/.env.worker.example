# Railway sportsbook-render-worker only. Never copy these provider credentials to backend.
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=224
DATABASE_URL=replace-with-Railway-Postgres-reference
REDIS_URL=replace-with-Railway-Redis-reference

# Sole production sportsbook odds source.
SPORTRADAR_ENABLED=true
SPORTRADAR_API_KEY=replace-with-Sportradar-production-key
SPORTRADAR_BASE_URL=https://api.sportradar.com/oddscomparison-prematch/production/v2/en
SPORTRADAR_SPORT_IDS=sr:sport:1
SPORTRADAR_DAYS_AHEAD=7
SPORTRADAR_MAX_PAGES=0
SPORTRADAR_MAX_EVENTS=0
SPORTRADAR_MAX_CALLS_PER_HOUR=20
# Required production safety gate: use the exact values shown in Sportradar Console.
# INITIAL_30_DAY_USAGE is captured once in Redis on first run; do not guess or reset it.
SPORTRADAR_MAX_CALLS_PER_30_DAYS=replace-with-product-rolling-30-day-quota
SPORTRADAR_INITIAL_30_DAY_USAGE=replace-with-current-product-rolling-30-day-usage
SPORTRADAR_MIN_INTERVAL_MS=1100
SPORTRADAR_REFRESH_SECONDS=300

# Signed delivery to backend over Railway private networking.
SPORTSBOOK_INGEST_URL=http://gasterus-v3.railway.internal/api/internal/sportsbook/ingest
SPORTSBOOK_INGEST_HMAC_SECRET=replace-with-the-same-random-secret-as-backend
SPORTSBOOK_INGEST_MAX_AGE_SECONDS=600
SPORTSBOOK_RENDER_MAX_EVENTS=0
SPORTSBOOK_RENDER_MAX_PAGES=0
SPORTSBOOK_DAILY_REFRESH_ENABLED=true
SPORTSBOOK_CRON_ONCE=true
