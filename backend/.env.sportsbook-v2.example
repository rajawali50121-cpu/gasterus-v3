# Sportradar Odds Comparison Prematch v2 trial worker; read-only evaluation mode.
# Set request ceilings from the actual Odds Comparison product quota in the account dashboard; internal cap: 800 calls/30 days.
# One selected sport, current UTC date, complete paginated Daily Sport Event Markets every 150 minutes.
# Change Log is disabled. One page per market cycle plus daily discovery is the minimum quota projection; extra pages consume rolling quota.
# Never commit the real API key. Keep it in Railway's sealed variables.
NODE_ENV=production
DATABASE_URL=use-Railway-Postgres-reference
REDIS_URL=use-Railway-Redis-reference
SPORTRADAR_ODDS_ENABLED=false
SPORTRADAR_API_KEY=replace-in-Railway-only
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE=en
SPORTRADAR_SPORT_IDS=sr:sport:1
SPORTRADAR_DAYS_AHEAD=0
SPORTRADAR_TARGET_EVENTS=50
SPORTRADAR_MARKET_PAGE_SIZE=50
SPORTRADAR_MAX_CALLS_PER_30_DAYS=800
SPORTRADAR_MAX_CALLS_PER_HOUR=0
SPORTRADAR_INITIAL_30_DAY_USAGE=replace-with-provider-reported-usage
SPORTRADAR_QUOTA_BASELINE_CONFIRMED=false
SPORTRADAR_TIMEOUT_MS=15000
SPORTSBOOK_POLL_MINUTES=150
SPORTRADAR_CHANGELOG_ENABLED=false

# Separate Soccer API v4 result worker. Quota and usage must come from the Soccer
# product's account reporting; do not copy the Odds Comparison usage number.
SPORTRADAR_SOCCER_ENABLED=false
SPORTRADAR_SOCCER_API_KEY=
SPORTRADAR_SOCCER_ACCESS_LEVEL=trial
SPORTRADAR_SOCCER_LANGUAGE=en
SPORTRADAR_SOCCER_MAX_CALLS_PER_30_DAYS=replace-with-Soccer-product-quota
SPORTRADAR_SOCCER_INITIAL_30_DAY_USAGE=replace-with-Soccer-product-usage
SPORTRADAR_SOCCER_QUOTA_BASELINE_CONFIRMED=false
SPORTRADAR_SOCCER_POLL_MINUTES=60
SPORTRADAR_SOCCER_MAX_CALLS_PER_CYCLE=2
SPORTRADAR_SOCCER_RESULT_BUFFER_MINUTES=150
SPORTRADAR_SOCCER_MAX_LOOKBACK_DAYS=2
SPORTRADAR_SOCCER_TIMEOUT_MS=15000

# Bet acceptance and settlement remain disabled until production readiness gates pass.
SPORTSBOOK_BET_ACCEPTANCE_ENABLED=false
SPORTSBOOK_PRICE_MAX_AGE_SECONDS=900
SPORTSBOOK_SETTLEMENT_ENABLED=false
SPORTSBOOK_SETTLEMENT_POLL_SECONDS=15
SPORTSBOOK_SETTLEMENT_BATCH_SIZE=50
SPORTSBOOK_BET_MAX_STAKE_IDR=replace-with-approved-limit
SPORTSBOOK_BET_MAX_PAYOUT_IDR=replace-with-approved-limit
