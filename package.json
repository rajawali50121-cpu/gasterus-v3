{
  "name": "gasterus-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gasterus Clean Rebuild v3",
  "scripts": {
    "start": "node deploy/launcher.js",
    "dev:backend": "node deploy/launcher.js",
    "dev:frontend": "npx serve frontend -p 3000",
    "verify:sportsbook:e2e": "node scripts/verify-sportsbook-e2e.mjs",
    "test": "node --test backend/tests/*.test.js",
    "check": "node scripts/check-syntax.js && node scripts/check-css-syntax.js && node scripts/check-asset-version.js",
    "migrate": "node backend/migrations/migrate.js",
    "schema:ready": "node backend/migrations/schema-ready.js"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "postcss": "^8.5.29"
  }
}
